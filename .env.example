# Optional. TripFill works fully without any keys.
# If set, the server lightly polishes highlight descriptions with OpenAI.
OPENAI_API_KEY=
# Contact info for the Wikimedia User-Agent (email or URL)
TRIPFILL_CONTACT=
# PORT is set by Render; locally defaults to 8787
PORT=8787
# Legacy short-link store only (ephemeral on Render free); new portable links need no store
TRIPFILL_SHARE_DIR=

# Optional: force the description rewriter off (QA or a strictly free deployment)
# TRIPFILL_DISABLE_AI=1
